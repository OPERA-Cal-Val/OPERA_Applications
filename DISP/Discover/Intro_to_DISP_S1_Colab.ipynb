      "    recommended_mask            (time, y, x) float32 680MB dask.array<chunksize=(4, 1270, 1632), meta=np.ndarray>\n",
      "    estimated_phase_quality     (time, y, x) float32 680MB dask.array<chunksize=(4, 1270, 1632), meta=np.ndarray>\n",
